
NODE_ENV=production
PORT=3000

# Se estiver atrás de proxy (Nginx, Cloudflare, Render, etc.), use 1
TRUST_PROXY=1

# Dados de contato (entregues pelo backend, não ficam fixos no código do site)
CONTACT_EMAIL=emplacamerco@gmail.com
CONTACT_WHATSAPP=5511939355088

# Token para consultar os contatos recebidos (gere um valor longo e aleatório):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Sal para anonimizar IPs nos registros (valor longo e aleatório)
IP_SALT=

# Domínio oficial do site (usado para validar a origem das requisições)
SITE_ORIGIN=https://www.toxicologicazonanorte.com.br
